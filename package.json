{
  "name": "@ryze-digital/scss-utilities",
  "description": "Contains several helpers and utilities for our Sass projects ",
  "license": "MIT",
  "version": "1.2.0",
  "author": "RYZE Digital GmbH <kontakt@ryze-digital.de> (https://www.ryze-digital.de/)",
  "type": "module",
  "repository": "github:ryze-digital/scss-utilities",
  "scripts": {
    "lint": "npm run lint:styles",
    "lint:styles": "prettier src/** ./*.scss --check && stylelint src/** ./*.scss",
    "lint-fix": "npm run lint-fix:styles",
    "lint-fix:styles": "prettier src/** ./*.scss --write && npm run lint:styles -- --fix"
  },
  "keywords": [
    "sass",
    "dartsass",
    "scss",
    "utilities"
  ],
  "devDependencies": {
    "@ryze-digital/prettier-config-website": "^2.0.0",
    "@ryze-digital/stylelint-config-website": "^2.0.0"
  },
  "engines": {
    "node": ">=24.15",
    "npm": ">=11"
  }
}
